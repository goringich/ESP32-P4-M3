repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo_idf="$repo_root/esp-idf"
fallback_idf="$HOME/esp/esp-idf"

if [ -f "$repo_idf/export.sh" ]; then
  export IDF_PATH="$repo_idf"
elif [ -f "$fallback_idf/export.sh" ]; then
  export IDF_PATH="$fallback_idf"
else
  echo "ESP-IDF not found. Initialize the pinned submodule: git submodule update --init --recursive esp-idf" >&2
  return 0
fi

PATH_add "$IDF_PATH/tools"
source "$IDF_PATH/export.sh" >/dev/null 2>&1 || true
